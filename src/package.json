{
	"name": "@bgroup/wise-form",
	"version": "0.0.4",
	"title": "",
	"description": "",
	"license": "ISC",
	"layout": "main-layout",
	"template": "template/template.json",
	"languages": {
		"default": "en",
		"supported": [
			"en",
			"es"
		]
	},
	"modules": {
		"path": "modules"
	},
	"deployment": {
		"distributions": [
			{
				"name": "web",
				"environment": "development",
				"platform": "web",
				"ports": {
					"bundles": 1530
				}
			},
			{
				"name": "web-tsc",
				"environment": "production",
				"platform": "web",
				"ports": {
					"bundles": 900
				},
				"ts": {
					"compiler": "tsc"
				}
			}
		]
	},
	"dependencies": {
		"@beyond-js/kernel": "~0.1.9",
		"@beyond-js/react-18-widgets": "~1.0.1",
		"@beyond-js/reactive": "^1.1.9",
		"mathjs": "^12.4.1",
		"pragmate-ui": "^0.1.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-select": "^5.8.0",
		"socket.io-client": "^4.5.4"
	},
	"devDependencies": {
		"@beyond-js/local": "~0.1.3",
		"@types/react": "^18.0.26",
		"@types/react-dom": "^18.0.9",
		"typedoc": "^0.25.12"
	}
}
