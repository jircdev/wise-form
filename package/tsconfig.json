{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"lib": ["ES2020", "DOM"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"jsx": "react",
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"noImplicitAny": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noImplicitReturns": false,
		"noFallthroughCasesInSwitch": false,
		"types": [],
		"typeRoots": ["./node_modules/@types"],
		"baseUrl": ".",
		"paths": {
			"@bgroup/wise-form/models": ["./src/models"],
			"@bgroup/wise-form/models/*": ["./src/models/*"],
			"@bgroup/wise-form/formulas": ["./src/formulas"],
			"@bgroup/wise-form/formulas/*": ["./src/formulas/*"],
			"@bgroup/wise-form/form": ["./src/form"],
			"@bgroup/wise-form/form/*": ["./src/form/*"],
			"@bgroup/wise-form/settings": ["./src/settings"],
			"@bgroup/wise-form/settings/*": ["./src/settings/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
